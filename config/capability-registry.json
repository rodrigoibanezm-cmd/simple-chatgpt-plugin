{
  "version": "0.4",
  "purpose": "Authoritative capability catalog returned by DECIDE. Each capability publishes both the deterministic EXECUTE input contract and the R2 output contract.",
  "capabilities": {
    "AGENCY_PROFILE": {
      "description": "Return certified institutional profile facts.",
      "intentions": [
        "ABOUT",
        "WHY_SIMPLE",
        "FIT"
      ],
      "input_contract": {
        "section": {
          "type": "enum",
          "values": [
            "IDENTITY",
            "TEAM",
            "CAPABILITIES",
            "POSITIONING",
            "ASSOCIATIONS"
          ],
          "required": false
        }
      },
      "output_contract": {
        "status": [
          "OK",
          "NO_DATA",
          "INVALID_SCOPE",
          "NOT_APPLICABLE",
          "LIMITED_COVERAGE"
        ],
        "result": {
          "scope": "validated input scope",
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Profile facts; when no section is requested records are grouped by section."
            }
          },
          "evidence": "source provenance records"
        },
        "context": "object | null",
        "limitations": []
      }
    },
    "CLIENT_RELATION": {
      "description": "Return whether a canonical client is present in Simple's published client evidence.",
      "intentions": [
        "EXPERIENCE",
        "FIT",
        "WHY_SIMPLE"
      ],
      "input_contract": {
        "client_id": {
          "type": "canonical_id",
          "map": "CLIENT",
          "required": true
        }
      },
      "output_contract": {
        "status": [
          "OK",
          "NO_DATA",
          "INVALID_SCOPE",
          "NOT_APPLICABLE",
          "LIMITED_COVERAGE"
        ],
        "result": {
          "scope": "validated input scope",
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "fields": {
                "client_id": "string",
                "label": "string",
                "logo_url": "string | null",
                "industry_id": "string",
                "industry_label": "string",
                "published_works": {
                  "type": "array",
                  "items": {
                    "work_id": "string",
                    "title": "string",
                    "youtube_url": "string",
                    "source_url": "string"
                  }
                },
                "published_as_client": "boolean"
              }
            }
          },
          "evidence": "source provenance records"
        },
        "context": "object | null",
        "limitations": []
      }
    },
    "CLIENT_LIST": {
      "description": "Return published clients, optionally bounded by canonical client selection.",
      "intentions": [
        "EXPERIENCE",
        "WHY_SIMPLE",
        "FIT"
      ],
      "input_contract": {
        "client_ids": {
          "type": "canonical_id_array",
          "map": "CLIENT",
          "required": false
        }
      },
      "output_contract": {
        "status": [
          "OK",
          "NO_DATA",
          "INVALID_SCOPE",
          "NOT_APPLICABLE",
          "LIMITED_COVERAGE"
        ],
        "result": {
          "scope": "validated input scope",
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "fields": {
                "client_id": "string",
                "label": "string",
                "logo_url": "string | null",
                "industry_id": "string",
                "industry_label": "string",
                "published_works": {
                  "type": "array",
                  "items": {
                    "work_id": "string",
                    "title": "string",
                    "youtube_url": "string",
                    "source_url": "string"
                  }
                }
              }
            }
          },
          "evidence": "source provenance records"
        },
        "context": "object | null",
        "limitations": []
      }
    },
    "PORTFOLIO": {
      "description": "Return concrete published Simple work, optionally bounded by client.",
      "intentions": [
        "EXPERIENCE",
        "WHY_SIMPLE",
        "FIT"
      ],
      "input_contract": {
        "client_ids": {
          "type": "canonical_id_array",
          "map": "CLIENT",
          "required": false
        },
        "work_ids": {
          "type": "canonical_id_array",
          "map": "WORK",
          "required": false
        },
        "industry_ids": {
          "type": "canonical_id_array",
          "map": "INDUSTRY",
          "required": false
        }
      },
      "output_contract": {
        "status": [
          "OK",
          "NO_DATA",
          "INVALID_SCOPE",
          "NOT_APPLICABLE",
          "LIMITED_COVERAGE"
        ],
        "result": {
          "scope": "validated input scope",
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "fields": {
                "work_id": "string",
                "client_id": "string",
                "client": "string",
                "title": "string",
                "youtube_url": "string",
                "source_url": "string"
              }
            }
          },
          "evidence": "source provenance records"
        },
        "context": "object | null",
        "limitations": []
      }
    },
    "CREDENTIALS": {
      "description": "Return published awards, recognitions and associations.",
      "intentions": [
        "ABOUT",
        "EXPERIENCE",
        "WHY_SIMPLE",
        "FIT"
      ],
      "input_contract": {
        "credential_type": {
          "type": "enum",
          "values": [
            "AWARD",
            "RECOGNITION",
            "ASSOCIATION",
            "ALL"
          ],
          "required": false
        }
      },
      "output_contract": {
        "status": [
          "OK",
          "NO_DATA",
          "INVALID_SCOPE",
          "NOT_APPLICABLE",
          "LIMITED_COVERAGE"
        ],
        "result": {
          "scope": "validated input scope",
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "fields": {
                "credential_type": "AWARD | RECOGNITION | ASSOCIATION",
                "name": "string"
              }
            }
          },
          "evidence": "source provenance records"
        },
        "context": "object | null",
        "limitations": []
      }
    },
    "CONSUMER_INSIGHTS": {
      "description": "Return historical consumer statements published by Simple. Results must preserve source attribution and historical-status warning.",
      "intentions": [
        "CONSUMER",
        "FIT"
      ],
      "input_contract": {
        "insight_ids": {
          "type": "canonical_id_array",
          "map": "CONSUMER_INSIGHT",
          "required": false
        },
        "topic_ids": {
          "type": "canonical_id_array",
          "map": "CONSUMER_TOPIC",
          "required": false
        }
      },
      "output_contract": {
        "status": [
          "OK",
          "NO_DATA",
          "INVALID_SCOPE",
          "NOT_APPLICABLE",
          "LIMITED_COVERAGE"
        ],
        "result": {
          "scope": "validated input scope",
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "fields": {
                "insight_id": "string",
                "statement": "string",
                "attributed_source": "string",
                "page": "string",
                "source_url": "string",
                "historical": "boolean"
              }
            }
          },
          "limitations": [
            "HISTORICAL_SOURCE"
          ],
          "evidence": "source provenance records"
        },
        "context": "object | null",
        "limitations": [
          "HISTORICAL_SOURCE"
        ]
      }
    },
    "CONTACT_DIRECTORY": {
      "description": "Return published Simple contact routes, optionally by specialty.",
      "intentions": [
        "CONTACT"
      ],
      "input_contract": {
        "specialty_id": {
          "type": "canonical_id",
          "map": "SPECIALTY",
          "required": false
        }
      },
      "output_contract": {
        "status": [
          "OK",
          "NO_DATA",
          "INVALID_SCOPE",
          "NOT_APPLICABLE",
          "LIMITED_COVERAGE"
        ],
        "result": {
          "scope": "validated input scope",
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "fields": {
                "specialty_id": "string",
                "specialty": "string",
                "email": "string"
              }
            }
          },
          "evidence": "source provenance records"
        },
        "context": "object | null",
        "limitations": []
      }
    }
  },
  "notes": [
    "WHY_SIMPLE and FIT are synthesis intentions: DECIDE may expose multiple compatible capabilities; ChatGPT chooses the deterministic evidence needed.",
    "No capability currently certifies current-market WHY_NOW claims. TIMING requests must not be answered as current facts from historical consumer material.",
    "INDUSTRY and CONSUMER_TOPIC are explicit editorial canonical maps. They are backend-owned deterministic classifications and must not be represented as taxonomies published by Simple."
  ]
}
