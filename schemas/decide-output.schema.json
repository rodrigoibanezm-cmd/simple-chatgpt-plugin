{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplechile.com/schemas/decide-output.schema.json",
  "title": "Simple DECIDE Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "intention",
    "capabilities",
    "scope_maps"
  ],
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "intention": {
      "type": "string",
      "enum": [
        "ABOUT",
        "EXPERIENCE",
        "CONSUMER",
        "WHY_SIMPLE",
        "FIT",
        "CONTACT",
        "UNKNOWN"
      ]
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "TIMING"
        ]
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "input_contract",
          "output_contract"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "input_contract": {
            "type": "object",
            "description": "Machine-readable contract for the scope accepted by EXECUTE for this capability."
          },
          "output_contract": {
            "type": "object",
            "description": "Machine-readable contract describing the R2 shape returned by EXECUTE for this capability."
          }
        }
      }
    },
    "scope_maps": {
      "type": "object",
      "description": "Canonical maps explicitly requested by ChatGPT plus any map required by a backend-authorized continuation, so R1 is self-contained for semantic refinement.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "continuations": {
      "type": "array",
      "description": "Backend-authorized semantic refinements. A continuation expresses a useful unresolved dimension; it is independent of whether its canonical map was requested. Any required map is included in scope_maps. The LLM may resolve it from the user's existing language or ask a natural follow-up when unresolved.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "scope_map",
          "purpose"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "SCOPE_REFINEMENT"
            ]
          },
          "scope_map": {
            "type": "string",
            "enum": [
              "CLIENT",
              "WORK",
              "CONSUMER_INSIGHT",
              "SPECIALTY",
              "INDUSTRY",
              "CONSUMER_TOPIC"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
